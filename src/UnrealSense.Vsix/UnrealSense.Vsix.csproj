<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>UnrealSense.Extension</RootNamespace>
    <AssemblyName>UnrealSense</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.2.23</Version>

    <!-- VSIX packaging -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <DeployExtension Condition="'$(DeployExtension)' == ''">false</DeployExtension>

    <!-- F5 launches the experimental instance -->
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.551" />
    <!-- Provided by Visual Studio itself: never ship our own copy. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnrealSense.Core\UnrealSense.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <VSCTCompile Include="VSCommandTable.vsct" ResourceName="Menus.ctmenu" />
    <Content Include="Resources\Icon.png" IncludeInVSIX="true" />
    <Content Include="..\..\LICENSE.txt" Link="LICENSE.txt" IncludeInVSIX="true" Condition="Exists('..\..\LICENSE.txt')" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!-- VSSDK targets come from the Microsoft.VSSDK.BuildTools package (no VS workload needed). -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

  <!-- Assemblies that Visual Studio already ships: never package our own copies. -->
  <Target Name="ExcludeVsProvidedAssemblies" AfterTargets="GetVsixSourceItems">
    <ItemGroup>
      <VSIXSourceItem Remove="@(VSIXSourceItem)" Condition="!$([System.String]::Copy('%(VSIXSourceItem.VSIXSubPath)').StartsWith('OwnIndexer')) and ('%(Filename)' == 'Microsoft.VisualStudio.Extensibility.Editor.Contracts' or '%(Filename)' == 'Microsoft.VisualStudio.Linux.ConnectionManager.Store' or '%(Filename)' == 'System.Text.Encodings.Web')" />
    </ItemGroup>
  </Target>

  <!-- The experimental own C++ indexer (usindex, net8, option UseOwnIndex) ships in OwnIndexer\ as a separate process: the VSIX
       is net48. Self-contained, so the company PC needs no .NET 8 runtime. Published again only when its sources change. -->
  <PropertyGroup>
    <OwnIndexerRoot>$(MSBuildThisFileDirectory)..\..\experimental\</OwnIndexerRoot>
    <OwnIndexerProject>$(OwnIndexerRoot)UnrealSense.IndexerCli\UnrealSense.IndexerCli.csproj</OwnIndexerProject>
    <OwnIndexerDir>$(MSBuildThisFileDirectory)obj\OwnIndexer\</OwnIndexerDir>
  </PropertyGroup>
  <ItemGroup>
    <OwnIndexerSource Include="$(OwnIndexerRoot)UnrealSense.Indexer\*.cs;$(OwnIndexerRoot)UnrealSense.IndexerCli\*.cs;$(OwnIndexerRoot)**\*.csproj" Exclude="$(OwnIndexerRoot)**\obj\**;$(OwnIndexerRoot)**\bin\**" />
  </ItemGroup>
  <Target Name="PublishOwnIndexer" BeforeTargets="BeforeBuild" Condition="Exists('$(OwnIndexerProject)')" Inputs="@(OwnIndexerSource)" Outputs="$(OwnIndexerDir)usindex.exe">
    <Exec Command="dotnet publish &quot;$(OwnIndexerProject)&quot; -c Release -r win-x64 --self-contained true -p:PublishTrimmed=false -o &quot;$(OwnIndexerDir.TrimEnd('\'))&quot; --nologo -v q" />
    <Touch Files="$(OwnIndexerDir)usindex.exe" />
  </Target>
  <!-- Added to the package only (not as Content: its runtime's mscorlib/System.* would become reference candidates of this net48 build). -->
  <Target Name="IncludeOwnIndexer" AfterTargets="GetVsixSourceItems" Condition="Exists('$(OwnIndexerDir)usindex.exe')">
    <ItemGroup>
      <OwnIndexerFile Include="$(OwnIndexerDir)**\*" />
      <VSIXSourceItem Include="@(OwnIndexerFile)" VSIXSubPath="OwnIndexer\%(RecursiveDir)" />
    </ItemGroup>
  </Target>

</Project>